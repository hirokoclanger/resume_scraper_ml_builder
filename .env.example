# Template for .env. Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored; .env.example is safe to commit.

# Optional: override the default port (8765).
# JOB_FINDER_PORT=8765

# Apify token for the JobSpy actor (only needed for the scraper, not the
# tailoring engine). Leave blank if you do not run /api/scrape.
# APIFY_TOKEN=
